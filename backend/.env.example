PORT=3025
DB_HOST=localhost
DB_PORT=5454
DB_NAME=dodoli
DB_USER=dodoli_user
DB_PASSWORD=cambiar
JWT_SECRET=generar_con_openssl_rand_hex_32

# Instalación del cliente
CLIENTE_NOMBRE="Dr. Alejandro Dodoli"
CLIENTE_COLOR="#1E3A5F"
# Orden importa: odontologia y consentimientos dependen de pacientes (y odontologia de finanzas)
MODULOS=pacientes,agenda,finanzas,odontologia,consentimientos,respaldos
CORS_ORIGINS=

# Laptop sin nginx: el backend sirve la página (ruta absoluta a frontend/dist)
FRONTEND_DIST=

# Respaldos (módulo respaldos)
# pg_dump: en Windows la ruta completa, p. ej. C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
PG_DUMP=pg_dump
# Carpeta principal (por defecto backend/respaldos)
RESPALDOS_DIR=
# Copias extra separadas por ';' (USB / disco externo), p. ej. E:\RespaldosDodoli
RESPALDOS_COPIAS=
RESPALDOS_CONSERVAR=30
